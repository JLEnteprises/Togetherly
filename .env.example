# Togetherly client API
# Web / iOS simulator on the same computer:
EXPO_PUBLIC_API_URL=http://localhost:4000
# Physical phone on the same LAN, example:
# EXPO_PUBLIC_API_URL=http://192.168.1.50:4000
# Production / independent Apple Watch actions should use HTTPS.

# Expo/EAS push project. Run `eas init` to obtain this UUID.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Build identity. Pick a bundle ID you control before an Apple-signed build.
# Example: com.yourname.togetherly
EXPO_PUBLIC_IOS_BUNDLE_ID=com.example.togetherly
EXPO_PUBLIC_ANDROID_PACKAGE=com.example.togetherly

# Apple Developer Team ID (10 characters). Needed for Watch/widgets signing.
EXPO_PUBLIC_APPLE_TEAM_ID=
