# PostgreSQL connection string. The Docker Compose default below works as-is.
DATABASE_URL=postgresql://togetherly:togetherly@localhost:5432/togetherly

# Use a long random value in production (at least 32 characters).
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters

HOST=0.0.0.0
PORT=4000
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Password reset email. Togetherly uses Resend's HTTPS API when these are set.
# Example sender after verifying a domain in Resend: Togetherly <hello@yourdomain.com>
RESEND_API_KEY=
PASSWORD_RESET_FROM=
# Native deep link. For web hosting you may instead use your HTTPS reset page.
PASSWORD_RESET_LINK_BASE=togetherly://reset-password

# Local development only. When true outside NODE_ENV=production, the reset token
# is returned to the app so the flow can be tested without an email provider.
DEV_RETURN_PASSWORD_RESET_TOKEN=true
