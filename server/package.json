{
  "name": "togetherly-api",
  "version": "1.14.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migrate": "tsx src/db/migrate.ts",
    "smoke": "tsx src/smoke.ts",
    "logic": "node --import tsx ../src/utils/logicSmoke.ts && node --import tsx ../src/utils/draftSmoke.ts",
    "test:experience": "node --import tsx src/experienceSmoke.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "dotenv": "^17.0.0",
    "fastify": "^5.0.0",
    "pg": "^8.13.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3"
  }
}
